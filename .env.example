# MukiSoft Technology — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Never commit your real secrets.

# Supabase project URL and anon/publishable key.
# Both are safe to expose to the browser — they grant only the
# permissions allowed by your Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-side service-role key.
#
# Used only by server-side admin helpers (e.g. for trusted
# background jobs that need to bypass RLS after explicit
# authorization checks). NEVER expose this through NEXT_PUBLIC_*.
#
# Leave empty if you do not need server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Translation APIs (server-only, used by /api/translate).
#
# LibreTranslate is the primary provider. If LIBRETRANSLATE_URL is
# unset, MyMemory (translated.net) is used as the only provider.
# LIBRETRANSLATE_API_KEY is optional for self-hosted / public mirrors.
# MYMEMORY_EMAIL (optional) unlocks a higher anonymous quota.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=